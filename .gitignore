# ===== 依赖 =====
node_modules/

# ===== 构建产物 =====
dist/
C-Quest.zip

# ===== 可执行文件（能用源码重新编译）=====
# 注意：tools/tcc/ 里的编译器是要随仓库分发的，下面单独放行
/c-quest.exe
/practice.exe
*.o

# ===== 运行时生成的临时文件 =====
practice.c
practice_in.txt
practice_out.txt
cquest_save.txt
numbers.txt
_t_demo.txt
_t_app.txt
_t_r.txt

# ===== 验证脚本的临时目录 =====
build/.tmp/
build/.tmp-hands/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志 =====
*.log
npm-debug.log*

# ===== 保留：编译器本体（终端版需要）=====
!tools/tcc/tcc.exe
!tools/tcc/libtcc.dll
